---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, video, duration } = Astro.props;
const src = `/videos/${video}.html`;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 1100px;
				margin: auto;
				padding: 2em 1em;
			}
			.title {
				text-align: center;
				padding: 0 0 1em 0;
			}
			.title h1 {
				margin: 0 0 0.3em 0;
			}
			.date {
				color: rgb(var(--gray));
			}
			.player {
				width: 100%;
				height: calc(100vh - 140px);
				min-height: 640px;
				border: 1px solid #ddd;
				border-radius: 12px;
				background: #fff;
				box-shadow: var(--box-shadow);
			}
			.open {
				text-align: center;
				margin: 0.8em 0 2em 0;
				color: rgb(var(--gray));
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: auto;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{duration && <span> · 解説動画 {duration}</span>}
					</div>
					<h1>{title}</h1>
				</div>
				<iframe class="player" src={src} title={title} loading="lazy"></iframe>
				<p class="open">
					<a href={src} target="_blank" rel="noopener">動画だけを別タブで開く</a>
				</p>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
