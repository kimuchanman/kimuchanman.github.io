---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, video, duration, embed } = Astro.props;
const src = video ? `/videos/${video}.html` : `/${embed}.html`;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: var(--content-width);
				margin: auto;
				padding: 2em 1em;
			}
			.title {
				text-align: center;
				padding: 0 0 1em 0;
			}
			.title h1 {
				margin: 0 0 0.3em 0;
			}
			.date {
				color: rgb(var(--gray));
			}
			.player {
				width: 100%;
				height: 760px; /* 読み込み後に中身の高さへ合わせる(下の script) */
				overflow: hidden;
				border: 1px solid #ddd;
				border-radius: 12px;
				background: #fff;
				box-shadow: var(--box-shadow);
			}
			.open {
				text-align: center;
				margin: 0.8em 0 2em 0;
				color: rgb(var(--gray));
			}
			.prose {
				margin: auto;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{duration && <span> · 解説動画 {duration}</span>}
					</div>
					<h1>{title}</h1>
				</div>
				<iframe class="player" id="player" src={src} title={title} scrolling="no" style={embed ? 'height: 900px' : undefined}></iframe>
				<script is:inline>
					// 同一オリジンなので中身の高さを読み、iframe 内でスクロールしなくて済む高さにする
					(() => {
						const f = document.getElementById('player');
						const fit = () => {
							const d = f.contentDocument;
							if (!d || !d.documentElement) return;
							// documentElement.scrollHeight は iframe 自身の高さを下回らないので、一度伸びると縮まない。中身(.wrap)の実寸で測る
					const w = d.querySelector('.wrap');
					const h = w ? Math.ceil(w.getBoundingClientRect().bottom + parseFloat(getComputedStyle(w).marginBottom || '0')) : d.documentElement.scrollHeight;
							if (h > 100) f.style.height = h + 'px';
						};
						f.addEventListener('load', () => {
							fit();
							const d = f.contentDocument;
							if (d && 'ResizeObserver' in window) new ResizeObserver(fit).observe(d.documentElement);
							window.addEventListener('resize', fit);
						});
					})();
				</script>
				<p class="open">
					<a href={src} target="_blank" rel="noopener">{video ? '動画' : embed?.startsWith('games/') ? 'ゲーム' : '図'}だけを別タブで開く</a>
				</p>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
