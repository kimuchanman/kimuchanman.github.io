---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			ul li a {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.9em 0;
				text-decoration: none;
			}
			.date {
				flex: 0 0 7.5em;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
				white-space: nowrap;
			}
			.title {
				margin: 0;
				font-size: 1.05em;
				font-weight: 600;
				color: rgb(var(--black));
				line-height: 1.4;
			}
			.kind {
				display: inline-block;
				font-size: 0.7em;
				vertical-align: middle;
				margin-right: 0.6em;
				padding: 0.1em 0.5em;
				border: 1px solid rgb(var(--gray));
				border-radius: 999px;
				color: rgb(var(--gray));
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				ul li a {
					flex-direction: column;
					gap: 0.2em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h4 class="title">{(post.data.video || post.body?.includes('class="video-embed"')) && <span class="kind">動画</span>}{post.data.embed?.startsWith('games/') && <span class="kind">ゲーム</span>}{((post.data.embed && !post.data.embed.startsWith('games/')) || post.body?.includes('class="map-embed"')) && <span class="kind">図</span>}{post.data.title}</h4>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
